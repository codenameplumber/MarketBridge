{
  "name": "KonfluenX — Connect. Discover. Converge.",
  "short_name": "KonfluenX",
  "id": "/konfluenx/",
  "description": "KonfluenX is the Deriv-connected social trading platform. Trade supported contracts, follow verified traders, get real signals and join market rooms that matter.",
  "start_url": "users/index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#080B0F",
  "theme_color": "#080B0F",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "finance",
    "business",
    "social"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Trade",
      "short_name": "Trade",
      "description": "Open the trading modules",
      "url": "users/trade/index.html",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Signals",
      "short_name": "Signals",
      "description": "Latest signals and analysis",
      "url": "users/signals/index.html",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Community",
      "short_name": "Community",
      "description": "Market discussions",
      "url": "users/community/index.html",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Open contracts",
      "short_name": "Positions",
      "description": "Your running positions",
      "url": "users/trade/open-contracts.html",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
